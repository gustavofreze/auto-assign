{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "BASH_MAX_TIMEOUT_MS": "1800000",
        "BASH_MAX_OUTPUT_LENGTH": "50000",
        "BASH_DEFAULT_TIMEOUT_MS": "600000"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-env-files.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-prose-punctuation.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    }
                ]
            },
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "if": "Edit(*.py)",
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-python-hexagonal-layers.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    },
                    {
                        "if": "Edit(*.py)",
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-python-suppressions.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    }
                ]
            },
            {
                "matcher": "Write",
                "hooks": [
                    {
                        "if": "Write(*.py)",
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-python-hexagonal-layers.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    },
                    {
                        "if": "Write(*.py)",
                        "type": "command",
                        "args": [
                            "-B",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-python-suppressions.py"
                        ],
                        "command": "python3",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt|idle_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "notify-send 'Claude Code' 'Permission or input needed'"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "notify-send 'Claude Code' 'Task complete'"
                    }
                ]
            }
        ]
    },
    "language": "portuguese",
    "attribution": {
        "pr": "",
        "commit": ""
    },
    "permissions": {
        "defaultMode": "default",
        "additionalDirectories": [
            ".."
        ],
        "allow": [
            "Read(./.env.local)",
            "Edit(./.env.local)",
            "Write(./.env.local)",
            "Read",
